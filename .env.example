# ── Required credentials ──────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
DEEPGRAM_API_KEY=your_deepgram_api_key
GOOGLE_API_KEY=your_google_api_key
CARTESIA_API_KEY=your_cartesia_api_key

# ── Voice pipeline (optional — sensible defaults in services/config.py) ─
# STT_MODEL=nova-3
# LLM_MODEL=gemini-2.5-flash
# TTS_MODEL=sonic-3
# TTS_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02
# TTS_LANGUAGE=hi
# TTS_SPEED=1.0
# USE_TURN_DETECTOR=true        # set false to fall back to plain VAD endpointing

# ── Local-dev settings ────────────────────────────────────────────────
EVENTS_LOG_PATH=runtime/call_events.jsonl
MOCK_CRM_PATH=mock_data/drivers.json

# Fallback test driver (used only when no mock_data fixture matches the room)
TEST_DRIVER_ID=DRV-001
TEST_PHONE_NUMBER=+919999999999
TEST_DRIVER_NAME=Ramesh
TEST_AGENT_TYPE=collections
TEST_CALL_TYPE=
TEST_DUE_DATE=25 October
TEST_SCENARIO=A
TEST_LOAN_AMOUNT=4200
TEST_BATTERY_ID=BAT-1001
